{
  "ci": {
    "collect": {
      "puppeteerLaunchOptions": {
        "args": [
          "--no-sandbox",
          "--disable-setuid-sandbox",
          "--disable-dev-shm-usage",
          "--disable-gpu"
        ]
      },
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/profile",
        "http://127.0.0.1:4173/settings",
        "http://127.0.0.1:4173/terms",
        "http://127.0.0.1:4173/privacy",
        "http://127.0.0.1:4173/cookie",
        "http://127.0.0.1:4173/impressum",
        "http://127.0.0.1:4173/contact"
      ],
      "numberOfRuns": 1,
      "puppeteerScript": "tests/perf/lhci-login.cjs",
      "chromeFlags": ["--no-sandbox", "--disable-setuid-sandbox"]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.77 }],
        "categories:accessibility": ["error", { "minScore": 0.77 }],
        "categories:best-practices": ["error", { "minScore": 0.77 }],
        "categories:seo": ["error", { "minScore": 0.77 }],
        "resource-summary:script.size": ["error", { "maxNumericValue": 588800 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2875 }],
        "total-blocking-time": ["error", { "maxNumericValue": 345 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "tests/perf/lhci-output"
    }
  }
}
