  %% =========================================================
  roles ||--o{ users : assigns

  users ||--|| profiles : has
  users ||--o{ user_contacts : has
  users ||--o{ user_state_history : logs
  users ||--o{ user_tombstones : tombstones
  users ||--o{ blacklist : created

  code_sets ||--o{ code_values : contains

  genders ||--o{ profiles : uses
  fitness_levels ||--o{ user_metrics : uses
  exercise_types ||--o{ exercises : categorizes
  exercise_categories ||--o{ exercises : groups
  exercises ||--o{ exercise_tags : tagged
  tags ||--o{ exercise_tags : applies

  users ||--o{ auth_sessions : has
  auth_sessions ||--o{ refresh_tokens : issues
  users ||--o{ refresh_tokens : owns
  users ||--o{ auth_tokens : owns
  users ||--o{ verification_tokens : verifies
  users ||--o{ reset_tokens : resets
  users ||--o{ pending_2fa_sessions : has
  users ||--|| user_2fa_settings : config
  users ||--o{ backup_codes : recovers
  users ||--o{ two_factor_backup_codes : recovers
  users ||--o{ two_factor_audit_log : logs

  users ||--o{ exercises : owns
  users ||--o{ plans : owns
  users ||--o{ workout_templates : creates
  plans ||--o{ sessions : schedules
  workout_templates ||--o{ sessions : instantiates
  users ||--o{ sessions : owns
  sessions ||--o{ session_exercises : includes
  exercises ||--o{ session_exercises : used_in
  session_exercises ||--o{ exercise_sets : has
  session_exercises ||--|| planned_exercise_attributes : planned
  session_exercises ||--|| actual_exercise_attributes : actual

  users ||--o{ user_metrics : tracks
  users ||--o{ personal_records : achieves
  exercises ||--o{ personal_records : records
  users ||--o{ body_measurements : tracks
  users ||--o{ recovery_logs : logs

  badge_catalog ||--o{ badges : defines
  users ||--o{ badges : earns
  users ||--o{ user_points : earns

  users ||--o{ feed_items : publishes
  sessions ||--o{ feed_items : summarizes
  feed_items ||--o{ feed_likes : liked_by
  users ||--o{ feed_likes : likes
  feed_items ||--o{ feed_comments : has
  users ||--o{ feed_comments : writes
  feed_comments ||--o{ feed_comments : replies
  sessions ||--o{ session_bookmarks : bookmarked
  users ||--o{ session_bookmarks : bookmarks
  users ||--o{ followers : follows
  users ||--o{ followers : followed
  users ||--o{ user_blocks : blocks
  users ||--o{ user_blocks : blocked
  users ||--o{ feed_reports : reports
  users ||--o{ feed_reports : resolves
  feed_items ||--o{ feed_reports : reported_item
  feed_comments ||--o{ feed_reports : reported_comment
  feed_items ||--o{ share_links : shared_via
