    text route
    text key
    text request_hash
    int response_status
    jsonb response_body
    timestamptz created_at
    timestamptz updated_at
    timestamptz deactivated_at
  }

  contact_messages {
    uuid id PK
    uuid user_id FK "-> users.id"
    text email
    text topic
    text message
    timestamptz created_at
    timestamptz read_at
    uuid read_by_user_id FK "-> users.id"
    timestamptz responded_at
    text response
    timestamptz deactivated_at
  }

  cookie_consents {
    uuid id PK
    text ip_address
    text consent_version
    boolean essential_cookies
    boolean preferences_cookies
    boolean analytics_cookies
    boolean marketing_cookies
    timestamptz consent_given_at
    timestamptz last_updated_at
    text user_agent
    timestamptz created_at
    timestamptz updated_at
    timestamptz deactivated_at
  }

  action_ui_mappings {
    text action PK
    text ui_name
    timestamptz created_at
    timestamptz updated_at
    timestamptz deactivated_at
  }

  %% =========================================================
  %% Extensibility (EAV)
  %% =========================================================
  attributes {
    uuid id PK
    text key
    text label
    text data_type
    text unit_set_key
    numeric min_value
    numeric max_value
    boolean is_time_series
    timestamptz created_at
    timestamptz deactivated_at
  }

  attribute_scopes {
    uuid attribute_id FK "-> attributes.id"
    text entity_type
    %% PK (attribute_id, entity_type)
