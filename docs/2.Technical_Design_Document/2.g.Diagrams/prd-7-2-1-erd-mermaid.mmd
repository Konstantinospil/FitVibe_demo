erDiagram
  roles {
    text code PK
    text description
    timestamptz created_at
  }

  genders {
    text code PK
    text description
    timestamptz created_at
  }

  fitness_levels {
    text code PK
    text description
    timestamptz created_at
  }

  exercise_types {
    text code PK
    text description
    timestamptz created_at
  }

  users {
    uuid id PK
    text display_name
    text locale
    text preferred_lang
    text status
    text role_code FK
    text password_hash
    text default_visibility
    text units
    boolean terms_accepted
    timestamptz deleted_at
    timestamptz purge_scheduled_at
    timestamptz backup_purge_due_at
  }

  media {
    uuid id PK
    uuid owner_id FK
    text storage_key
    text file_url
  }

  profiles {
    uuid user_id PK FK
    citext alias UK
    timestamptz alias_changed_at
    text visibility
    text fitness_level_code FK
    text training_frequency
    uuid avatar_asset_id FK
  }

  user_contacts {
    uuid id PK
    uuid user_id FK
    text type
    citext value
    boolean is_primary
  }

  user_tombstones {
    uuid id PK
    uuid user_id UK
    text email_hash
    text alias_hash
    timestamptz deleted_at
    timestamptz purged_at
  }

  user_state_history {
    uuid id PK
    uuid user_id FK
    text field
    jsonb old_value
    jsonb new_value
    uuid actor_user_id FK
    uuid request_id
    timestamptz changed_at
  }

  exercises {
    uuid id PK
    uuid owner_id FK
    text name
    text type_code FK
    boolean is_public
    text description
  }

  plans {
    uuid id PK
    uuid user_id FK
    text name
    text status
  }

  sessions {
    uuid id PK
    uuid owner_id FK
    uuid plan_id FK
    timestamptz planned_at
    text status
    text visibility
  }

  session_exercises {
    uuid id PK
    uuid session_id FK
    uuid exercise_id FK
    text exercise_name
    int order_index
  }

  exercise_sets {
    uuid id PK
    uuid session_exercise_id FK
    int order_index
    int reps
    numeric weight_kg
  }

  planned_exercise_attributes {
    uuid id PK
    uuid session_exercise_id FK
    int sets
    int reps
    numeric load
  }

  personal_records {
    uuid id PK
    uuid user_id FK
    uuid exercise_id FK
    text metric
    numeric value
    boolean is_current
  }

  auth_sessions {
    uuid jti PK
    uuid user_id FK
    timestamptz expires_at
  }

  refresh_tokens {
    uuid id PK
    uuid user_id FK
    uuid session_jti FK
  }

  auth_tokens {
    uuid id PK
    uuid user_id FK
    text token_type
    text token_hash
  }

  user_2fa_settings {
    uuid id PK
    uuid user_id FK
    boolean is_enabled
  }

  backup_codes {
    uuid id PK
    uuid user_id FK
    text code_hash
    boolean is_used
  }

  followers {
    uuid follower_id PK_FK
    uuid following_id PK_FK
  }

  feed_items {
    uuid id PK
    uuid owner_id FK
    uuid session_id FK
    text visibility
  }

  user_points {
    uuid id PK
    uuid user_id FK
    int points
    text source_type
  }

  audit_log {
    uuid id PK
    uuid actor_user_id FK
    text entity_type
    text action
    text outcome
    jsonb metadata
  }

  cookie_consents {
    uuid id PK
    uuid user_id FK
    text client_key
    text consent_version
    timestamptz consent_given_at
  }

  users ||--|| profiles : "alias handle"
  users ||--o{ user_contacts : has
  users ||--o{ sessions : owns
  users ||--o{ exercises : owns
  users ||--o{ auth_sessions : has
  users ||--o{ user_state_history : diffs
  users ||--o{ cookie_consents : consents
  roles ||--o{ users : "role_code"
  media ||--o| profiles : avatar
  sessions ||--o{ session_exercises : contains
  session_exercises ||--o{ exercise_sets : logs
  session_exercises ||--o| planned_exercise_attributes : targets
  sessions ||--o| feed_items : published
  users ||--o{ followers : graph
  users ||--o{ user_points : awards
  users ||--o{ audit_log : "actor SET NULL"
