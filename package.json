{
  "name": "fitvibe",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint --parallel",
    "lint:check": "turbo run lint --concurrency=1 -- --max-warnings=0",
    "test": "turbo run test --",
    "test:backend": "turbo run test --filter=@fitvibe/backend -- --coverage",
    "test:frontend": "turbo run test --filter=@fitvibe/frontend -- --coverage",
    "test:a11y": "pnpm --filter @fitvibe/frontend run build && playwright test tests/frontend/e2e/accessibility.spec.cjs --config tests/frontend/e2e/playwright.config.cjs --reporter=line",
    "test:contract": "pnpm -w openapi:build && pnpm --filter @fitvibe/backend exec jest tests/backend/contract/openapi.contract.test.ts --maxWorkers=1",
    "test:integration": "RUN_INTEGRATION_TESTS=1 pnpm --filter @fitvibe/backend exec jest --runInBand --testMatch=\"**/integration/**/*.test.ts\" --testPathIgnorePatterns=\"/node_modules/|verification-resend-limit\\.test\\.ts$|login-enumeration\\.test\\.ts$\"",
    "test:visual": "pnpm --filter @fitvibe/frontend run build:visual && playwright test --config tests/frontend/visual/config/playwright.config.ts",
    "test:visual:update": "pnpm --filter @fitvibe/frontend run build:visual && playwright test --config tests/frontend/visual/config/playwright.config.ts --update-snapshots",
    "test:visual:linux": "node tests/frontend/visual/scripts/update-linux-baselines.mjs",
    "test:coverage:gate": "node tests/qa/check-coverage.cjs",
    "perf:test": "node tests/perf/run-local-perf.mjs",
    "perf:lhci": "node tests/perf/run-lhci-local.mjs",
    "qa:summary": "node tests/qa/generate-summary.mjs",
    "i18n:check": "node tests/qa/check-i18n.cjs",
    "i18n:check:db": "pnpm --filter @fitvibe/backend run db:check-i18n",
    "security:scan": "node tests/security/run-security-checks.mjs",
    "typecheck": "turbo run typecheck",
    "openapi:build": "pnpm --filter @fitvibe/backend run openapi:build",
    "retention:run": "pnpm --filter @fitvibe/backend run db:retention",
    "secrets:rotate": "pnpm --filter @fitvibe/backend run db:rotate-secrets",
    "clean": "rimraf node_modules .turbo && pnpm install",
    "prepare": "husky install",
    "fmt": "prettier \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,yml,yaml}\" --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.37.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "istanbul-lib-coverage": "^3.2.2",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "pnpm": "10.34.5",
    "prettier": "3.7.4",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.5.6",
      "ip-address": ">=10.3.1",
      "fast-xml-builder": ">=1.1.7",
      "diff": "^4.0.4",
      "lodash-es": "^4.18.1",
      "lodash": ">=4.18.1",
      "handlebars": ">=4.7.9",
      "immutable": "4.3.9",
      "basic-ftp": "^5.3.1",
      "nanoid": "3.3.18",
      "postcss": ">=8.5.26",
      "vite": "^6.4.3",
      "vitest": "^3.2.6",
      "@remix-run/router": "1.23.2",
      "chrome-launcher": "^1.2.1",
      "preact": "10.28.2",
      "tmp": "^0.2.7",
      "glob": "link:packages/patched-glob",
      "extract-zip": "link:packages/patched-extract-zip",
      "esbuild": "^0.25.0",
      "js-yaml": ">=4.3.1",
      "jws": "4.0.1",
      "nodemailer": ">=9.0.1",
      "@smithy/core": "^3.33.3",
      "qs": ">=6.15.2",
      "uuid": "^11.1.1",
      "morgan": ">=1.12.0",
      "turbo": ">=2.9.14",
      "@babel/core": "7.29.7",
      "@opentelemetry/core": ">=2.8.0",
      "body-parser@1": "1.20.6",
      "path-to-regexp@0.1": "0.1.13",
      "yaml": ">=2.8.3",
      "express@4": "4.22.0",
      "minimatch@3": ">=3.1.4",
      "minimatch@5": ">=5.1.8",
      "minimatch@9": ">=9.0.7",
      "brace-expansion@1": "^1.1.12",
      "brace-expansion@2": "^2.0.2",
      "brace-expansion@5": ">=5.0.9",
      "protobufjs": ">=7.6.1",
      "flatted": ">=3.4.2",
      "form-data": ">=4.0.6",
      "axios": ">=1.16.0",
      "multer": ">=2.2.0",
      "ws": ">=8.21.0",
      "sharp": ">=0.35.0",
      "@grpc/grpc-js": ">=1.14.4",
      "@opentelemetry/auto-instrumentations-node": ">=0.75.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "ajv": "^6.14.0",
      "browserslist": ">=4.28.7"
    }
  },
  "overrides": {
    "js-yaml": ">=4.3.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.30",
    "@anthropic-ai/sdk": "^0.27.3",
    "openai": "^4.67.3",
    "snyk": "^1.1300.2"
  }
}
