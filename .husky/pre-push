# Run security checks before pushing
echo "🔒 Running security checks before push..."
pnpm security:scan

# Run dependency audit
echo "📦 Checking for dependency vulnerabilities..."
pnpm audit --audit-level=high || {
  echo "❌ High severity vulnerabilities found. Run 'pnpm audit' to see details."
  echo "   Fix vulnerabilities before pushing."
  exit 1
}
